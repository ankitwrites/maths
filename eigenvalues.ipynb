   "source": [
    "#Determine Eigenvalues\n",
    "\n",
    "import numpy as np\n",
    "\n",
    "A = np.array([[2, 0, -1], [0, 2, 0], [-1, 0, 2]])\n",
    "\n",
    "print(\"Given matrix: A =\\n {}\".format(A))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "92dd6d31-3c6c-4bfb-95a1-b0c427f8a263",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Eigenvalues: [3. 1. 2.]\n"
     ]
    }
   ],
   "source": [
    "#using numpy library\n",
    "\n",
    "eigenvalues = np.linalg.eigvals(A)\n",
    "\n",
    "print(\"Eigenvalues: {}\".format(np.round(eigenvalues, 10)))"
   ]
  }
 ],
