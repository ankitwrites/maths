   "source": [
    "#heart curve\n",
    "\n",
    "x = []\n",
    "y = []\n",
    "\n",
    "for t in range(-10000, 10000):\n",
    "    x.append(16 * np.sin(t)**3)\n",
    "    y.append(13 * np.cos(t) - 5 * np.cos(2 * t) - 2 * np.cos(3 * t) - np.cos(4 * t))\n",
    "\n",
    "plt.plot(x, y)\n",
    "plt.show()"
   ]
  }
